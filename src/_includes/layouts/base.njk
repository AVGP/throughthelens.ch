<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.seo.title }}</title>

  <!-- SEO Meta Tags -->
  <meta name="description" content="{{ description or site.seo.description }}">
  <meta name="keywords" content="{{ site.seo.keywords }}">
  <meta name="author" content="{{ site.businessName }}">
  <meta property="og:title" content="{{ site.businessName }}">
  <meta property="og:description" content="{{ site.seo.ogDescription }}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="{{ site.seo.ogImage }}">

  <!-- Typography (Google Fonts) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <!-- Theme + components, bundled into one file (see src/assets/css/bundle.11ty.js) -->
  <link rel="stylesheet" href="/assets/css/main.css">

  <link rel="icon" type="image/png" href="/assets/images/favicon.png">
</head>
<body>
  {% include "partials/header.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script src="/assets/js/nav.js"></script>
  <script src="/assets/js/reveal.js"></script>
</body>
</html>
