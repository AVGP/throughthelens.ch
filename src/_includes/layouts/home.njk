---
layout: layouts/base.njk
---
<!-- Hero Section -->
<section id="hero" class="hero-section">
  <div class="hero-overlay"></div>
  <div class="hero-content reveal-on-scroll">
    <div class="hero-logo-container">
      <img src="{{ hero.logo }}" alt="Through The Lens Logo" class="hero-logo">
    </div>
    <h1 class="hero-title">{{ hero.title }}</h1>
    <p class="hero-subtitle">{{ hero.subtitle }}</p>
    <div class="hero-cta-group">
      <a href="{{ hero.primaryButton.url }}" class="btn btn-primary">{{ hero.primaryButton.label }}</a>
      <a href="{{ hero.secondaryButton.url }}" class="btn btn-secondary">{{ hero.secondaryButton.label }}</a>
    </div>
  </div>
  <div class="scroll-indicator" aria-hidden="true">
    <span class="scroll-mouse"><span class="scroll-wheel"></span></span>
    <span class="scroll-text">{{ hero.scrollText }}</span>
  </div>
</section>

{% for offering in collections.offerings %}
{% include "partials/offering-section.njk" %}
{% endfor %}

{% include "partials/instagram-grid.njk" %}

{% include "partials/booking-form.njk" %}

{{ content | safe }}

<script src="/assets/js/booking.js"></script>
